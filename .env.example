# Copy to .env.local for development. Never commit .env.local — it is gitignored.
# In production these are set in Vercel → Project → Settings → Environment Variables.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# The public origin, with no trailing slash. Used for canonical URLs, Open
# Graph tags and the sitemap. Set this in Vercel for Production; leave it unset
# in Preview so previews do not claim to be the live site.
NEXT_PUBLIC_SITE_URL=https://northboundweb.co.uk

# ---------------------------------------------------------------------------
# Enquiry form (Resend)
# ---------------------------------------------------------------------------
# Server-side only. This key must never appear in client-side code — anything
# prefixed NEXT_PUBLIC_ is shipped to the browser, so do not rename it.
# Create at: Resend → API Keys. "Sending access" permission is enough.
RESEND_API_KEY=

# Where enquiries are delivered — your real inbox.
CONTACT_TO_EMAIL=

# The From address. Must be on a domain you have verified in Resend
# (Resend → Domains), otherwise sending fails.
CONTACT_FROM_EMAIL=Northbound Web <enquiries@northboundweb.co.uk>

# ---------------------------------------------------------------------------
# Payments (Stripe Checkout)
# ---------------------------------------------------------------------------
# Entirely optional. With none of these set the site works exactly as before:
# the package selector's button becomes "start an enquiry" instead of
# "continue to secure checkout", and nothing breaks.
#
# Server-side only. None of these may ever be renamed to NEXT_PUBLIC_* — that
# prefix ships the value to the browser.
#
# USE A TEST KEY (sk_test_...) FOR DEVELOPMENT AND PREVIEW.
# src/lib/checkout/stripe.ts refuses to run a live key (sk_live_...) anywhere
# except production, so a branch deploy cannot charge a real card.
# Create at: Stripe → Developers → API keys.
STRIPE_SECRET_KEY=

# Verifies that a webhook really came from Stripe. Without it the webhook
# endpoint returns 503 and accepts nothing, which is the correct failure:
# an unverified payment event must never be treated as a payment.
#
# Local:      stripe listen --forward-to localhost:3000/api/stripe/webhook
#             (the CLI prints a whsec_... to paste here)
# Deployed:   Stripe → Developers → Webhooks → add endpoint
#             https://<your-domain>/api/stripe/webhook
#             Events: checkout.session.completed, checkout.session.expired
STRIPE_WEBHOOK_SECRET=

# Which payment methods a customer is offered — card, wallets, Klarna where
# they are eligible — is configured in Stripe, not in this repository:
# Stripe → Settings → Payment methods. The code deliberately does not send a
# payment_method_types list, so anything enabled there appears automatically.
# Northbound never calculates or promises instalment terms.
