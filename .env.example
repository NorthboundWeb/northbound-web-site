# Copy to .env.local for development. Never commit .env.local — it is gitignored.
# In production these are set in Vercel → Project → Settings → Environment Variables.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# The public origin, with no trailing slash. Used for canonical URLs, Open
# Graph tags and the sitemap. Set this in Vercel for Production; leave it unset
# in Preview so previews do not claim to be the live site.
NEXT_PUBLIC_SITE_URL=https://northboundweb.co.uk

# ---------------------------------------------------------------------------
# Enquiry form (Resend)
# ---------------------------------------------------------------------------
# Server-side only. This key must never appear in client-side code — anything
# prefixed NEXT_PUBLIC_ is shipped to the browser, so do not rename it.
# Create at: Resend → API Keys. "Sending access" permission is enough.
RESEND_API_KEY=

# Where enquiries are delivered — your real inbox.
CONTACT_TO_EMAIL=

# The From address. Must be on a domain you have verified in Resend
# (Resend → Domains), otherwise sending fails.
CONTACT_FROM_EMAIL=Northbound Web <enquiries@northboundweb.co.uk>
