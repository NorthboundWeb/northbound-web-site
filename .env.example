# Copy to .env.local for development. Never commit .env.local — it is gitignored.
# In production these are set in Vercel → Project → Settings → Environment Variables.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# The public origin, with no trailing slash. Used for canonical URLs, Open
# Graph tags and the sitemap. Set this in Vercel for Production; leave it unset
# in Preview so previews do not claim to be the live site.
NEXT_PUBLIC_SITE_URL=https://northboundweb.co.uk

# ---------------------------------------------------------------------------
# Enquiry form (Google Apps Script inbox)
# ---------------------------------------------------------------------------
# Each enquiry is sent to a small Google Apps Script web app, which emails it to
# you and logs it in a Google Sheet. Setup steps are at the top of
# apps-script/enquiries.gs.
#
# Both values are server-side only. They must never appear in client-side code:
# anything prefixed NEXT_PUBLIC_ is shipped to the browser, so do not rename
# them.

# The Web app URL from Apps Script → Deploy → Web app.
ENQUIRY_WEBHOOK_URL=

# The same long random string you set as SHARED_SECRET in the script's
# properties. It is what stops strangers posting to the Web app URL.
ENQUIRY_WEBHOOK_TOKEN=
