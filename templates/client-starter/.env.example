# Copy to .env.local for development. Never commit .env.local: it is gitignored.
# In production these are set in Vercel → Project → Settings → Environment Variables.

# The public origin, no trailing slash. Used for canonical URLs, the sitemap and
# Open Graph tags. Set for Production; leave unset in Preview so previews do not
# claim to be the live site.
NEXT_PUBLIC_SITE_URL=https://example.co.uk

# Contact form (Resend). Server-side only: never rename these to NEXT_PUBLIC_*,
# which would ship the key to every visitor's browser.
RESEND_API_KEY=
# Where enquiries are delivered: the client's real inbox.
CONTACT_TO_EMAIL=
# Must be on a domain verified in Resend → Domains, or sending fails.
CONTACT_FROM_EMAIL=Client Name <enquiries@example.co.uk>
